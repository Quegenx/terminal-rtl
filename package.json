{
  "name": "terminal-rtl",
  "description": "Hebrew RTL display correction and lightweight formatting for native terminal AI agents.",
  "version": "0.1.8",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.2",
  "bin": {
    "terminal-rtl": "bin/terminal-rtl.mjs",
    "codex-rtl": "bin/codex-rtl.mjs",
    "grok-rtl": "bin/grok-rtl.mjs"
  },
  "scripts": {
    "start": "bun bin/codex-rtl.mjs",
    "grok": "bun bin/grok-rtl.mjs",
    "test": "bun test",
    "test:node": "node scripts/checks/test-node.mjs",
    "lint": "cargo clippy --all-targets --locked -- -D warnings",
    "check:notices": "node scripts/packaging/notices.mjs",
    "prepack": "node scripts/packaging/notices.mjs && node scripts/packaging/check-package.mjs",
    "check:structure": "node scripts/checks/structure.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quegenx/terminal-rtl.git"
  },
  "homepage": "https://github.com/Quegenx/terminal-rtl",
  "files": [
    "bin/",
    "native/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_LICENSES.txt",
    "docs/"
  ],
  "author": "Gal Havkin",
  "devDependencies": {
    "@xterm/headless": "6.0.0"
  }
}
